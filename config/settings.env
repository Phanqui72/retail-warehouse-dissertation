# =====================================================================
#  HẰNG SỐ KHÔNG BÍ MẬT — mọi container đều nạp file này (env_file). Được commit.
#  Bí mật (mật khẩu) để trong .env. Muốn đổi tham số: sửa Ở ĐÂY, không sửa trong code/compose.
# =====================================================================

# ---- chung ----
TZ=Asia/Ho_Chi_Minh

# ---- PostgreSQL (metadata) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# database cho Iceberg catalog và Airflow (postgres-init tự tạo nếu chưa có)
ICEBERG_CATALOG_DB=iceberg_catalog
AIRFLOW_DB=airflow

# ---- MinIO / S3 ----
S3_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1
LAKEHOUSE_BUCKET=lakehouse
LANDING_BUCKET=landing
LANDING_PREFIX=vn_beauty
# script khởi tạo chờ service sẵn sàng: số lần thử × số giây giữa 2 lần
INIT_MAX_RETRIES=60
INIT_RETRY_SECONDS=3

# ---- Iceberg REST catalog ----
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_REST_HEAP=256m
# 2 biến dưới đây image tabulario/iceberg-rest đọc trực tiếp (CATALOG_x_y -> x.y, __ -> -)
CATALOG_IO__IMPL=org.apache.iceberg.aws.s3.S3FileIO
CATALOG_S3_PATH__STYLE__ACCESS=true

# ---- Spark ----
SPARK_CATALOG=lake
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1500m
SPARK_SHUFFLE_PARTITIONS=8
SPARK_LOG_LEVEL=WARN

# ---- Trino ----
TRINO_CATALOG=lakehouse

# ---- Landing (phần 2) ----
# thư mục dữ liệu đã giải nén BÊN TRONG container landing-upload (mount từ ./data/landing)
LANDING_SRC_DIR=/data/landing
# giữ lại dữ liệu từ ngày này trở đi để demo replay hằng ngày (không upload khi nạp lịch sử)
REPLAY_START=2026-07-01
UPLOAD_WORKERS=8

# ---- Bronze (phần 2) ----
BRONZE_NAMESPACE=bronze
OPS_NAMESPACE=ops
ICEBERG_FORMAT_VERSION=2
ICEBERG_COMPRESSION=zstd
# các dataset giao hằng ngày (daily/dt=…/<dataset>.csv)
BRONZE_DAILY_DATASETS=orders,order_items,order_payments,order_status_history,order_reviews,customers,inventory_movements,inventory_snapshots_daily,purchase_orders,stock_counts,listing_traffic_daily,ads_spend_daily,market_prices

# ---- Silver (phần 3) ----
SILVER_NAMESPACE=silver
# thư mục cấu hình YAML BÊN TRONG container spark (mount từ ./config)
SILVER_CONFIG_DIR=/opt/config/silver
# ngày chốt dữ liệu của bộ VN Beauty: bản ghi tạo sau ngày này là sai (ORD-10)
DATA_CUTOFF_DATE=2026-09-30